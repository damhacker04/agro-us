# Salin menjadi apps/web/.env.local untuk menjalankan frontend dengan API lokal.
# NEXT_PUBLIC_* dapat dibaca browser. Jangan menaruh secret di berkas ini.
# Tanpa nilai ini, frontend memakai alamat cadangan API daring dalam src/lib/api.ts.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Restart dev server setelah perubahan. Jika memakai hasil build, build ulang:
# Next.js menanam NEXT_PUBLIC_* ke bundle saat build.
