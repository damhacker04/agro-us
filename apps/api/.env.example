# Salin jadi `.env` (jangan commit .env).
#
# Butuh PostgreSQL + ekstensi PostGIS. XAMPP TIDAK menyediakan PostgreSQL.
# Cara tercepat (Docker):
#   docker run -d --name agrous-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=agrous -p 5432:5432 postgis/postgis:16-3.4
# Alternatif tanpa Docker: Supabase (free tier, PostGIS tinggal diaktifkan) — pakai connection string "Direct".
#
# Setelah DB nyala:
#   pnpm --filter @agro-os/api exec prisma migrate dev   # apply migration + auto-seed
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrous"

# --- Auth (feat/auth-otp) ---
# Rahasia tanda tangan JWT. WAJIB diganti di production.
JWT_SECRET="ganti-dengan-string-acak-panjang"
# Pepper hash kode OTP (kode tidak pernah disimpan plaintext).
OTP_PEPPER="ganti-juga-ini"
# Port API (FE Next.js di 3000).
PORT=3001
