# Salin jadi `.env` (jangan commit .env).
#
# Butuh PostgreSQL + ekstensi PostGIS. XAMPP TIDAK menyediakan PostgreSQL.
# Cara tercepat (Docker) — ganti <PASSWORD> dengan sandi pilihanmu:
#   docker run -d --name agrous-db -e POSTGRES_PASSWORD=<PASSWORD> -e POSTGRES_DB=agrous -p 5432:5432 postgis/postgis:16-3.4
# Alternatif tanpa Docker: Supabase (free tier, PostGIS tinggal diaktifkan) — pakai connection string "Direct".
#
# Setelah DB nyala:
#   pnpm --filter @agro-os/api exec prisma migrate deploy   # apply migration
#   pnpm --filter @agro-os/api run db:seed                  # zona + komoditas
DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/agrous"

# --- Auth ---
# WAJIB diisi. Aplikasi MENOLAK BOOT bila kosong — tidak ada nilai cadangan,
# karena secret bawaan yang terlanjur ada di repositori bisa dipakai siapa pun
# untuk memalsukan token (termasuk role OPERATOR).
#
# Buat nilai acak:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=            # minimal 32 karakter
OTP_PEPPER=            # minimal 16 karakter, buat dengan perintah yang sama

# Port API (FE Next.js di 3000).
PORT=3001

# Origin FE yang diizinkan CORS, dipisah koma. Default: http://localhost:3000
# CORS_ORIGIN="https://agrous.id"
