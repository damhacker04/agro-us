// AgroUs — Prisma schema (PostgreSQL + PostGIS)
// Sumber kebenaran desain: docs/diagrams/05-erd.md (v2.2) + docs/PRD.md v2.2.
//
// Kolom geometry memakai `Unsupported(...)` — Prisma belum first-class untuk PostGIS.
// Konsekuensi: INSERT/UPDATE pada model ber-geometry wajib lewat $queryRaw/$executeRaw
// (ST_GeomFromGeoJSON dst). SELECT non-geometry tetap bisa via Prisma Client biasa.
//
// Aturan integritas yang TIDAK terlihat di file ini (hidup di prisma/migrations/0_init):
//   - CREATE EXTENSION postgis
//   - Trigger append-only: timeline_nodes, node_photos, escrow_ledger, hash_anchors (PRD §6.1)
//   - CHECK constraints (kuota, pin_attempts, quota_multiplier, FAILED⟹fulfilled=0)
//   - GiST index untuk semua kolom geometry
//
// Agregat permintaan (FR-8.1) TIDAK memakai materialized view. Matview v1 di 0_init
// sudah di-DROP pada migrasi 20260729000000_demand_signals — alasannya ditulis di sana.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================== ENUMS ==============================
// Selaras dengan packages/shared/src/index.ts — ubah keduanya bersamaan.

enum UserRole {
  TENANT
  BUYER
  OPERATOR
}

enum LegalityStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CaptureMethod {
  GAMBAR_PETA
  WALK_AROUND
}

enum VerificationTier {
  NORMAL
  TERBATAS // poligon < 0,1 ha — FR-1.6
}

enum Grade {
  A
  B
  C
}

/** Penilaian kewajaran hasil panen (FR-4.10). */
enum YieldPlausibility {
  WAJAR
  PERLU_DITINJAU
  TIDAK_WAJAR
  /// Sistem TIDAK punya dasar menilai — berbeda dari "marginal". Tidak ada penalti (FR-7.12e).
  TIDAK_DAPAT_DINILAI
}

/// Atas dasar apa penilaian dibuat — WAJAR dari pita saja tidak sekuat WAJAR dari pita + benchmark.
enum AssessmentBasis {
  PITA_SAJA
  PITA_PLUS_BENCHMARK
  TIDAK_ADA_DASAR
}

enum FailureReason {
  CUACA
  HAMA
  PENYAKIT
  LAINNYA
}

/// Callback disbursement bisa gagal; tanpa status ini ledger menyatakan dana cair padahal belum.
enum SettlementStatus {
  PENDING
  SUCCESS
  RETRY
}

enum Season {
  MUSIM_HUJAN
  MUSIM_KEMARAU
}

enum CommodityCategory {
  DAUN
  BUAH_UMBI
  KERING
}

enum ProductionStatus {
  PLANNING
  GROWING
  HARVESTED
  FAILED
}

enum VerificationStatus {
  TERVERIFIKASI
  FOTO_SAJA
  PERLU_DITINJAU
  TIDAK_DAPAT
  TIDAK_SESUAI
}

enum TimelineActivity {
  PENYIAPAN_LAHAN
  PENANAMAN
  PEMUPUKAN
  PENGENDALIAN_HAMA
  PENGAIRAN
  PANEN
  GAGAL_PANEN // FR-4.9 — deklarasi gagal/panen sebagian
}

enum PhotoType {
  KEGIATAN
  NOTA_INPUT // bukti sekunder pemupukan/pestisida — FR-4.7
}

enum CaptureSource {
  IN_APP_CAMERA
  GALLERY // ditandai berbeda, menurunkan kepercayaan node — §5.4.1
}

enum OrderStatus {
  DRAFT
  PAID
  CLOSED
}

enum ShipmentStatus {
  MENUNGGU_PANEN
  PANEN
  DIKIRIM
  TIBA_DI_LOKASI
  DITERIMA
  SELESAI
  DIBATALKAN // FR-7.5 — hanya dari MENUNGGU_PANEN
}

enum ReceivedMode {
  BUYER_CONFIRM
  AUTO_60MIN // fallback §5.6.4 — jendela klaim jadi 24 jam
}

enum PaymentGatewayKind {
  MIDTRANS
  XENDIT
}

enum PaymentMethod {
  QRIS
  VA
  EWALLET
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum EscrowEntryType {
  HOLD
  RELEASE30 // pencairan sebagian maks 30% saat Panen — FR-7.3
  POTONG_KLAIM
  RELEASE
  REFUND
  BIAYA_BATAL10 // FR-7.5
  // Dana pindah ke Tenant pengganti saat pembeli memilih SUBSTITUSI (FR-7.4).
  // Bukan REFUND: pembeli tidak menerima uang, barangnya yang diganti.
  ALIH_SUBSTITUSI
}

enum SessionEndReason {
  BUYER_CONFIRM
  EXPIRED
}

enum ClaimRoute {
  TOLAK_TOLERANSI // dalam toleransi susut — FR-5.2
  AUTO_SETTLE // < 10% nilai order — FR-5.5
  OPERATOR // > 10%, SLA 1 hari kerja — FR-5.6
}

enum AssuranceOption {
  SUBSTITUSI
  JADWAL_ULANG
  REFUND
  TERIMA_SEBAGIAN // FR-7.10 — pembeli di perbatasan alokasi
}

enum DemandSignalType {
  CARI_KOSONG // pembeli menyaring katalog per komoditas, hasilnya nihil
  KUOTA_HABIS // checkout gagal karena kuota keburu direbut
}

enum SubscriptionPlan {
  VERIFIED
}

enum SubscriptionStatus {
  ACTIVE
  GRACE // tenggang 14 hari — FR-9.4
  EXPIRED
}

// ============================== IDENTITAS ==============================

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @unique // login OTP — FR-1.3
  email     String? // opsional
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant?  @relation("TenantProfile")
  buyer           Buyer?
  reviewedTenants Tenant[] @relation("TenantReviewer")
  reviewedClaims  Claim[]  @relation("ClaimReviewer")
  reviewedYields  YieldAssessment[] @relation("PenilaiKewajaran")

  @@map("users")
}

model Tenant {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String         @unique @map("user_id") @db.Uuid
  companyName          String         @map("company_name")
  logoUrl              String?        @map("logo_url")
  legalityStatus       LegalityStatus @default(PENDING) @map("legality_status") // FR-1.7
  legalityDocUrl       String?        @map("legality_doc_url") // unggahan NIB / KTP pemilik — FR-1.7
  reviewedById         String?        @map("reviewed_by") @db.Uuid
  claimRatioCached     Decimal?       @map("claim_ratio_cached") @db.Decimal(5, 2) // tampil publik — FR-5.7
  // Rasio mentah DIGANTI posisi relatif terhadap rata-rata zona (ERD v2.3, FR-7.12f).
  // Angka mentah mengundang dibandingkan dengan ambang; posisi relatif tidak.
  yieldPositionCached  Decimal?       @map("yield_position_cached") @db.Decimal(6, 2) // FR-7.12f
  cleanCyclesStreak    Int            @default(0) @map("clean_cycles_streak") // pulih setelah 2 siklus wajar — FR-7.12d
  quotaMultiplier      Decimal        @default(0.70) @map("quota_multiplier") @db.Decimal(3, 2) // 0.70 normal, 0.50 penalti — FR-7.12

  user          User                @relation("TenantProfile", fields: [userId], references: [id])
  reviewedBy    User?               @relation("TenantReviewer", fields: [reviewedById], references: [id])
  landPlots     LandPlot[]
  products      Product[]
  subscriptions Subscription[]
  tenantZones   TenantZone[]
  escrowEntries EscrowLedgerEntry[]
  shortfallSeniority ShortfallSeniority[]

  @@map("tenants")
}

model Buyer {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String  @unique @map("user_id") @db.Uuid
  companyName  String  @map("company_name")
  activeZoneId String? @map("active_zone_id") @db.Uuid // kota layanan — FR-2.1 (null sampai pilih kota)

  user                User                 @relation(fields: [userId], references: [id])
  activeZone          Zone?                @relation(fields: [activeZoneId], references: [id])
  orders              Order[]
  traceabilityReports TraceabilityReport[]
  demandSignals       DemandSignal[]
  shortfallSeniority  ShortfallSeniority[]

  @@map("buyers")
}

// ============================== WILAYAH & KOMODITAS ==============================

model Zone {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String @unique
  city          String
  minOrderValue Int    @map("min_order_value") // gerbang unit economics — Risiko 3

  tenantZones   TenantZone[]
  buyers        Buyer[]
  shipments     Shipment[]
  demandSignals DemandSignal[]

  @@map("zones")
}

model TenantZone {
  tenantId String @map("tenant_id") @db.Uuid
  zoneId   String @map("zone_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  zone   Zone   @relation(fields: [zoneId], references: [id])

  @@id([tenantId, zoneId])
  @@map("tenant_zones")
}

model Commodity {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String            @unique
  category           CommodityCategory
  shrinkTolerancePct Decimal           @map("shrink_tolerance_pct") @db.Decimal(4, 2) // 5 daun / 3 buah-umbi — FR-5.2
  avgYieldKgPerHa    Decimal           @map("avg_yield_kg_per_ha") @db.Decimal(10, 2) // basis pembatas kuota — FR-3.3 ⚠ validasi BPS
  growingDaysMin     Int               @default(30) @map("growing_days_min") // umur tanam minimal — kewajaran panen FR-4.8 ⚠ validasi penyuluh
  gradeStandards     Json              @map("grade_standards")
  ambientStable      Boolean           @default(false) @map("ambient_stable") // stabil suhu ruang — §11.2

  products      Product[]
  demandSignals DemandSignal[]
  seasonBaselines CommoditySeasonBaseline[]

  @@map("commodities")
}

// ============================== LAHAN & PRODUK ==============================

model LandPlot {
  id               String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                                 @map("tenant_id") @db.Uuid
  polygon          Unsupported("geometry(Polygon, 4326)") // FR-1.5 — insert via ST_GeomFromGeoJSON
  // Luas setelah membuang piksel tepi — dasar PITA kewajaran (kuota tetap pakai areaHa).
  // Nullable: untuk poligon lama nilainya belum pernah dihitung, dan menebaknya berarti
  // membuat pita yang salah lalu menghukum orang berdasarkan tebakan itu.
  effectiveAreaHa  Decimal?         @map("effective_area_ha") @db.Decimal(10, 4)
  areaHa           Decimal                                @map("area_ha") @db.Decimal(8, 2)
  captureMethod    CaptureMethod                          @map("capture_method")
  verificationTier VerificationTier                       @default(NORMAL) @map("verification_tier") // TERBATAS jika < 0,1 ha — FR-1.6

  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  batches               Batch[]
  satelliteObservations SatelliteObservation[]

  @@index([tenantId])
  @@map("land_plots")
}

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  commodityId    String   @map("commodity_id") @db.Uuid
  name           String
  grade          Grade // FR-5.1
  pricePerBox    Int      @map("price_per_box") // rupiah integer
  qtyKgPerBox    Decimal  @map("qty_kg_per_box") @db.Decimal(6, 2)
  stockBox       Int      @default(0) @map("stock_box")
  estHarvestDate DateTime @map("est_harvest_date") @db.Date
  description    String? // FR-3.2

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  commodity Commodity @relation(fields: [commodityId], references: [id])
  batches   Batch[]

  @@index([tenantId])
  @@index([commodityId])
  @@map("products")
}

model Batch {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId           String             @map("product_id") @db.Uuid
  landPlotId          String             @map("land_plot_id") @db.Uuid // satu batch satu poligon — FR-3.4
  claimedPlantDate    DateTime?          @map("claimed_plant_date") @db.Date
  claimedHarvestDate  DateTime           @map("claimed_harvest_date") @db.Date
  quotaBoxTotal       Int                @map("quota_box_total") // CHECK ≤ 70% kapasitas dihitung aplikasi — FR-3.3
  quotaBoxSold        Int                @default(0) @map("quota_box_sold")
  quotaBoxFulfilled   Int?               @map("quota_box_fulfilled") // hasil panen aktual — FR-7.8; FAILED ⟹ 0 (CHECK di SQL)
  lockedPrice         Int                @map("locked_price")
  productionStatus    ProductionStatus   @default(PLANNING) @map("production_status")
  // Panen sebagian TIDAK punya status sendiri: diturunkan dari quotaBoxFulfilled < quotaBoxSold (§5.7.2).
  verificationStatus  VerificationStatus @default(FOTO_SAJA) @map("verification_status") // FR-4.5
  detectedPlantDate   DateTime?          @map("detected_plant_date") @db.Date // hasil NDVI
  detectedHarvestDate DateTime?          @map("detected_harvest_date") @db.Date
  peakNdvi            Decimal?           @map("peak_ndvi") @db.Decimal(6, 4) // masukan pita — FR-4.10
  plausibilityCached  YieldPlausibility? @map("plausibility_cached") // salinan verdict terkini

  product                Product               @relation(fields: [productId], references: [id])
  landPlot               LandPlot              @relation(fields: [landPlotId], references: [id])
  timelineNodes          TimelineNode[]
  hashAnchors            HashAnchor[]
  yieldAssessments       YieldAssessment[]
  orderItems             OrderItem[]
  failedResolutions      AssuranceResolution[] @relation("FailedBatch")
  replacementResolutions AssuranceResolution[] @relation("ReplacementBatch")

  @@index([productId])
  @@index([landPlotId])
  @@map("batches")
}

// ============================== VERIFIED TIMELINE (APPEND-ONLY) ==============================

model TimelineNode {
  id                   String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId              String                               @map("batch_id") @db.Uuid
  seq                  Int // urutan dalam batch
  activityType         TimelineActivity                     @map("activity_type") // 7 jenis — §5.4.1 + FR-4.9
  description          String // maks 280 karakter (validasi aplikasi)
  gpsPoint             Unsupported("geometry(Point, 4326)") @map("gps_point") // wajib dalam poligon — FR-4.3
  deviceTs             DateTime                             @map("device_ts") @db.Timestamptz(6)
  serverTs             DateTime                             @default(now()) @map("server_ts") @db.Timestamptz(6)
  prevHash             String?                              @map("prev_hash") // null hanya untuk node pertama batch
  nodeHash             String                               @unique @map("node_hash") // SHA-256 berantai — §5.4.1
  ralatOfId            String?                              @map("ralat_of") @db.Uuid // node "Ralat" — FR-4.2
  failureReason        FailureReason?                       @map("failure_reason") // FR-4.9
  outsidePolygonReason String?                              @map("outside_polygon_reason") // tampil ke pembeli — FR-4.3

  batch   Batch          @relation(fields: [batchId], references: [id])
  ralatOf TimelineNode?  @relation("Ralat", fields: [ralatOfId], references: [id])
  ralats  TimelineNode[] @relation("Ralat")
  photos  NodePhoto[]

  @@unique([batchId, seq])
  @@map("timeline_nodes")
}

model NodePhoto {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId        String        @map("node_id") @db.Uuid
  objectUrl     String        @map("object_url")
  photoType     PhotoType     @map("photo_type")
  captureSource CaptureSource @map("capture_source")
  exifLat       Decimal?      @map("exif_lat") @db.Decimal(9, 6)
  exifLng       Decimal?      @map("exif_lng") @db.Decimal(9, 6)
  exifTs        DateTime?     @map("exif_ts") @db.Timestamptz(6)
  sha256        String

  node TimelineNode @relation(fields: [nodeId], references: [id])

  @@index([nodeId])
  @@map("node_photos")
}

model SatelliteObservation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  landPlotId String   @map("land_plot_id") @db.Uuid
  sceneDate  DateTime @map("scene_date") @db.Date
  cloudPct   Decimal  @map("cloud_pct") @db.Decimal(5, 2) // > 40% dibuang — §6.2
  ndviMean   Decimal? @map("ndvi_mean") @db.Decimal(6, 4)
  ndmiMean   Decimal? @map("ndmi_mean") @db.Decimal(6, 4)
  usable     Boolean

  landPlot LandPlot @relation(fields: [landPlotId], references: [id])

  @@unique([landPlotId, sceneDate])
  @@map("satellite_observations")
}

model HashAnchor {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId     String    @map("batch_id") @db.Uuid
  anchorDate  DateTime  @map("anchor_date") @db.Date
  rootHash    String    @map("root_hash")
  externalRef String?   @map("external_ref") // penyimpanan write-once eksternal — §6.1
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  batch Batch @relation(fields: [batchId], references: [id])

  @@unique([batchId, anchorDate])
  @@map("hash_anchors")
}

/**
 * Bukti permintaan yang GAGAL dilayani (FR-8.1).
 *
 * Tanpa tabel ini permintaan hanya terlihat dari pesanan yang berhasil — padahal
 * justru pencarian yang nihil dan checkout yang kalah kuota-lah yang menunjukkan
 * ke mana pasokan seharusnya ditambah.
 */
model DemandSignal {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId       String           @map("zone_id") @db.Uuid
  commodityId  String?          @map("commodity_id") @db.Uuid // null bila pencarian bebas teks
  buyerId      String?          @map("buyer_id") @db.Uuid
  signalType   DemandSignalType @map("signal_type")
  // Disimpan dalam KG, bukan box: isi box berbeda antar Tenant sehingga box tidak
  // bisa dijumlahkan lintas produk. Hanya terisi untuk KUOTA_HABIS.
  qtyKgWanted  Decimal?         @map("qty_kg_wanted") @db.Decimal(10, 2)
  searchTerm   String?          @map("search_term")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  zone      Zone       @relation(fields: [zoneId], references: [id])
  commodity Commodity? @relation(fields: [commodityId], references: [id])
  buyer     Buyer?     @relation(fields: [buyerId], references: [id])

  @@index([zoneId, commodityId, createdAt])
  @@map("demand_signals")
}

model Subscription {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  plan        SubscriptionPlan   @default(VERIFIED)
  priceMonth  Int                @default(199000) @map("price_month") // Sumber 2 — FR-9.1
  periodStart DateTime           @map("period_start") @db.Date
  periodEnd   DateTime           @map("period_end") @db.Date
  graceUntil  DateTime?          @map("grace_until") @db.Date // tenggang 14 hari — FR-9.4
  status      SubscriptionStatus @default(ACTIVE)
  // Gerbang verifikasi BATCH BARU saja; badge lama permanen — FR-9.2, FR-9.3.

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

// ============================== TRANSAKSI ==============================

model Order {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId     String      @map("buyer_id") @db.Uuid
  totalAmount Int         @map("total_amount")
  traceabilityReportOpted Boolean @default(false) @map("traceability_report_opted") // FR-2.10
  orderStatus OrderStatus @default(DRAFT) @map("order_status")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  buyer         Buyer               @relation(fields: [buyerId], references: [id])
  items         OrderItem[]
  shipments     Shipment[]
  payments      Payment[]
  escrowEntries EscrowLedgerEntry[]

  @@index([buyerId])
  @@map("orders")
}

model OrderItem {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String @map("order_id") @db.Uuid
  shipmentId      String @map("shipment_id") @db.Uuid // rencana pengiriman terbentuk saat checkout — FR-2.4
  batchId         String @map("batch_id") @db.Uuid
  qtyBox          Int    @map("qty_box")
  qtyBoxFulfilled Int?   @map("qty_box_fulfilled") // hasil alokasi FIFO — FR-7.9
  // SENGAJA redundan terhadap SHORTFALL_SENIORITY (ERD v2.3 poin 4): alokasi adalah
  // keputusan finansial yang harus dapat diaudit dari sisi pesanan TANPA join, dan
  // nilainya beku setelah alokasi selesai.
  seniorityApplied Boolean @default(false) @map("seniority_applied") // FR-7.13
  unitPriceLocked Int    @map("unit_price_locked")
  subtotal        Int

  order               Order                @relation(fields: [orderId], references: [id])
  shipment            Shipment             @relation(fields: [shipmentId], references: [id])
  batch               Batch                @relation(fields: [batchId], references: [id])
  boxQrTokens         BoxQrToken[]
  claims              Claim[]
  assuranceResolution AssuranceResolution?
  senioritasDilahirkan ShortfallSeniority[] @relation("SenioritasAsal")
  senioritasDipakai    ShortfallSeniority[] @relation("SenioritasTerpakai")

  @@index([orderId])
  @@index([shipmentId])
  @@index([batchId])
  @@map("order_items")
}

model Shipment {
  id                String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String                               @map("order_id") @db.Uuid
  zoneId            String                               @map("zone_id") @db.Uuid
  destPoint         Unsupported("geometry(Point, 4326)") @map("dest_point") // snapshot titik checkout — FR-2.7
  destRadiusM       Int                                  @default(100) @map("dest_radius_m") // §5.6.3
  // FR-2.7 — identitas penerima. Sebelumnya divalidasi di DTO checkout lalu DIBUANG:
  // kurir yang tiba di lokasi tidak tahu harus menyerahkan barang kepada siapa, dan
  // layar detail pesanan Tenant tidak punya data penerima untuk ditampilkan.
  recipientName     String                               @map("recipient_name")
  recipientPhone    String                               @map("recipient_phone")
  landmark          String?
  receivingHours    String                               @map("receiving_hours")
  status            ShipmentStatus                       @default(MENUNGGU_PANEN)
  courierPinHash    String?                              @map("courier_pin_hash") // Kode Antar di-hash — FR-6.1/6.3
  pinAttempts       Int                                  @default(0) @map("pin_attempts") // maks 5 — FR-6.3 (CHECK di SQL)
  receivedMode      ReceivedMode?                        @map("received_mode")
  podPhotoUrl       String?                              @map("pod_photo_url") // sinyal-2 dual-signal
  /// Notif-2 (FR-10.2) — kurir masuk radius 1 km. SENGAJA terpisah dari `arrivedAt`:
  /// jendela 60 menit dihitung dari kedatangan, bukan dari notifikasi pertama yang
  /// diterima pembeli, dan tanpa dua kolom aturan itu tidak dapat ditegakkan maupun
  /// diaudit (ERD v2.3 poin 7).
  notified1kmAt     DateTime?                            @map("notified_1km_at") @db.Timestamptz(6)
  arrivedAt         DateTime?                            @map("arrived_at") @db.Timestamptz(6)
  claimWindowEndsAt DateTime?                            @map("claim_window_ends_at") @db.Timestamptz(6) // 2 jam / 24 jam
  completedAt       DateTime?                            @map("completed_at") @db.Timestamptz(6)

  order               Order                @relation(fields: [orderId], references: [id])
  zone                Zone                 @relation(fields: [zoneId], references: [id])
  items               OrderItem[]
  trackingSessions    TrackingSession[]
  claims              Claim[]
  escrowEntries       EscrowLedgerEntry[]
  traceabilityReports TraceabilityReport[]

  @@index([orderId])
  @@index([zoneId])
  @@map("shipments")
}

model Payment {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String             @map("order_id") @db.Uuid
  gateway    PaymentGatewayKind
  method     PaymentMethod
  invoiceRef String             @unique @map("invoice_ref")
  amount     Int
  status     PaymentStatus      @default(PENDING)
  expiresAt  DateTime           @map("expires_at") @db.Timestamptz(6)
  paidAt     DateTime?          @map("paid_at") @db.Timestamptz(6) // ⚠ KUNCI URUTAN ALOKASI FIFO — FR-7.9

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

model EscrowLedgerEntry {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String          @map("order_id") @db.Uuid
  shipmentId String?         @map("shipment_id") @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid // tujuan pencairan per tenant
  entryType  EscrowEntryType @map("entry_type")
  amount     Int // selalu positif; arah dana ditentukan entryType
  gatewayRef String?         @map("gateway_ref")
  /// Default PENDING, BUKAN SUCCESS. Enam dari tujuh jenis entri adalah arus keluar yang
  /// masih menunggu instruksi ke mitra pembayaran; hanya HOLD yang benar-benar sukses saat
  /// barisnya dibuat. Default yang salah untuk mayoritas baris adalah jebakan — lupa
  /// menyetelnya harus berarti MENGAKU BELUM, bukan mengaku sudah.
  settlementStatus SettlementStatus @default(PENDING) @map("settlement_status")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  // APPEND-ONLY (trigger di SQL). Koreksi = entri baru, bukan edit.

  order    Order     @relation(fields: [orderId], references: [id])
  shipment Shipment? @relation(fields: [shipmentId], references: [id])
  tenant   Tenant    @relation(fields: [tenantId], references: [id])

  @@index([orderId])
  @@index([tenantId])
  @@map("escrow_ledger")
}

// ============================== LOGISTIK ZERO-INSTALL ==============================

model BoxQrToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  token       String    @unique // sekali pakai — FR-3.6
  printedAt   DateTime? @map("printed_at") @db.Timestamptz(6) // hanya pasca-Panen
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6) // terisi SETELAH Kode Antar benar — FR-6.2

  orderItem       OrderItem        @relation(fields: [orderItemId], references: [id])
  trackingSession TrackingSession?

  @@index([orderItemId])
  @@map("box_qr_tokens")
}

model TrackingSession {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId        String            @map("shipment_id") @db.Uuid
  activationTokenId String            @unique @map("activation_token_id") @db.Uuid
  noGpsMode         Boolean           @default(false) @map("no_gps_mode") // izin lokasi ditolak — §6.3
  startedAt         DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?         @map("ended_at") @db.Timestamptz(6)
  endedReason       SessionEndReason? @map("ended_reason")

  shipment        Shipment           @relation(fields: [shipmentId], references: [id])
  activationToken BoxQrToken         @relation(fields: [activationTokenId], references: [id])
  positions       TrackingPosition[]

  @@index([shipmentId])
  @@map("tracking_sessions")
}

model TrackingPosition {
  id          String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String                               @map("session_id") @db.Uuid
  point       Unsupported("geometry(Point, 4326)")
  deviceTs    DateTime                             @map("device_ts") @db.Timestamptz(6)
  serverTs    DateTime                             @default(now()) @map("server_ts") @db.Timestamptz(6)
  isPlausible Boolean                              @default(true) @map("is_plausible") // anti-spoof kecepatan & lompatan — §6.3

  session TrackingSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, serverTs])
  @@map("tracking_positions")
}

// ============================== MUTU & ASSURANCE ==============================

model Claim {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId String  @map("shipment_id") @db.Uuid
  /// Klaim menunjuk SATU item, bukan seluruh pengiriman: pembeli HORECA menerima
  /// puluhan SKU dan tiap komoditas punya toleransi susut berbeda (FR-5.2), jadi
  /// menimbang seluruh muatan sebagai satu angka tidak bisa dihitung tolerannya.
  orderItemId    String?    @map("order_item_id") @db.Uuid
  description    String
  photoUrl       String     @map("photo_url")
  actualWeightKg Decimal    @map("actual_weight_kg") @db.Decimal(8, 2) // hasil timbang — FR-5.4
  /// Kekurangan setelah dipotong toleransi susut. 0 bila masih dalam toleransi.
  claimableKg    Decimal    @default(0) @map("claimable_kg") @db.Decimal(8, 2)
  claimValue     Int        @map("claim_value")
  pctOfOrder     Decimal    @map("pct_of_order") @db.Decimal(5, 2)
  route          ClaimRoute // FR-5.5 / FR-5.6
  reviewedById   String?    @map("reviewed_by") @db.Uuid
  /// Nilai yang benar-benar dipotong dari escrow (operator bisa menyesuaikan).
  settledValue Int?      @default(0) @map("settled_value")
  slaDueAt     DateTime? @map("sla_due_at") @db.Timestamptz(6) // 1 hari kerja — FR-5.6
  finalStatus  String?   @map("final_status")
  reviewNote   String?   @map("review_note")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)

  shipment   Shipment   @relation(fields: [shipmentId], references: [id])
  orderItem  OrderItem? @relation(fields: [orderItemId], references: [id])
  reviewedBy User?      @relation("ClaimReviewer", fields: [reviewedById], references: [id])

  @@index([shipmentId])
  @@index([route, finalStatus])
  @@map("claims")
}

model AssuranceResolution {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId           String          @unique @map("order_item_id") @db.Uuid
  failedBatchId         String          @map("failed_batch_id") @db.Uuid
  chosenOption          AssuranceOption @map("chosen_option") // FR-7.4 / FR-7.10
  /// true bila verdict TIDAK_WAJAR — cap 10% gugur, Tenant tanggung selisih penuh (FR-7.11).
  capWaived Boolean @default(false) @map("cap_waived")
  shortfallBox          Int             @default(0) @map("shortfall_box") // porsi tak terpenuhi — FR-7.10
  priceGapBorneByTenant Int             @default(0) @map("price_gap_borne_by_tenant") // cap 10%; gugur bila tak terverifikasi — FR-7.11
  replacementBatchId    String?         @map("replacement_batch_id") @db.Uuid
  resolvedAt            DateTime        @default(now()) @map("resolved_at") @db.Timestamptz(6)

  orderItem        OrderItem @relation(fields: [orderItemId], references: [id])
  failedBatch      Batch     @relation("FailedBatch", fields: [failedBatchId], references: [id])
  replacementBatch Batch?    @relation("ReplacementBatch", fields: [replacementBatchId], references: [id])

  @@index([failedBatchId])
  @@map("assurance_resolutions")
}

model TraceabilityReport {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId    String  @map("buyer_id") @db.Uuid
  shipmentId String  @map("shipment_id") @db.Uuid
  pdfUrl     String? @map("pdf_url")
  price      Int     @default(25000) // Sumber 3; dibundel di tagihan checkout — FR-2.10
  paidRef    String? @map("paid_ref")

  buyer    Buyer    @relation(fields: [buyerId], references: [id])
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([buyerId])
  @@index([shipmentId])
  @@map("traceability_reports")
}

// DEMAND_AGGREGATES (FR-8.1) sengaja TIDAK dimodelkan di sini:
// ia materialized view (lihat migration 0_init) dan dibaca via $queryRaw.

// ============================== AUTH (OTP) ==============================
// Infrastruktur login FR-1.3 — bukan bagian ERD domain. Baris boleh dihapus/expire.

model OtpRequest {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String // nomor ternormalisasi +62…
  codeHash   String    @map("code_hash") // sha256(pepper|phone|kode) — kode TIDAK disimpan plaintext
  attempts   Int       @default(0) // salah maks 3× lalu wajib minta kode baru (ER-19, node T3)
  sentAt     DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6) // cooldown kirim ulang 60 dtk
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6) // TTL 5 menit
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, expiresAt])
  @@map("otp_requests")
}

/**
 * Senioritas shortfall (FR-7.13, baru v2.3).
 *
 * Alokasi FIFO atas `payments.paid_at` bersifat STRUKTURAL, bukan acak: pembeli yang
 * selalu membayar lambat — biasanya justru yang perlu persetujuan finance, artinya akun
 * yang lebih besar — akan selalu berada di ekor antrean dan terkena shortfall berulang
 * hingga churn. Pro-rata menyebar kerugian; FIFO memusatkannya pada subset yang tetap.
 *
 * Pembeli yang terkena shortfall naik ke prioritas teratas pada batch berikutnya dari
 * TENANT YANG SAMA. Berlaku satu siklus dan gugur setelah terpakai (`consumedAt`).
 * Sesama penyandang senioritas tetap diurutkan FIFO `paid_at`.
 *
 * Baris tidak dihapus saat terpakai — riwayatnya dipertahankan supaya bisa diaudit
 * mengapa suatu alokasi mendahulukan pembeli tertentu.
 */
model ShortfallSeniority {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId  String @map("buyer_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /**
   * ORDER ITEM yang shortfall-nya melahirkan senioritas ini — bukan batch.
   * Satu batch bisa melahirkan shortfall pada beberapa pembeli sekaligus, jadi menunjuk
   * batch kehilangan informasi shortfall YANG MANA yang sedang dikompensasi.
   */
  sourceOrderItemId String   @map("source_order_item_id") @db.Uuid
  grantedAt         DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  /** Item yang MEMAKAI senioritas ini pada siklus berikutnya — sesudah itu hak gugur. */
  consumedByOrderItemId String?   @map("consumed_by_order_item_id") @db.Uuid
  consumedAt            DateTime? @map("consumed_at") @db.Timestamptz(6)

  buyer          Buyer      @relation(fields: [buyerId], references: [id])
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  sourceOrderItem OrderItem @relation("SenioritasAsal", fields: [sourceOrderItemId], references: [id])
  consumedByOrderItem OrderItem? @relation("SenioritasTerpakai", fields: [consumedByOrderItemId], references: [id])

  @@index([tenantId, consumedAt])
  @@index([buyerId, consumedAt])
  @@map("shortfall_seniority")
}

/**
 * Kurva vegetasi & rendemen acuan per komoditas per musim (FR-4.10, §6.2 poin 8).
 *
 * Inilah aset kalibrasi yang PRD sebut sebagai moat teknis — yang tidak bisa ditiru
 * dalam enam bulan. `calibrationSource` menyatakan terus terang bahwa angkanya wajib
 * divalidasi ke penyuluh atau BPS, bukan ditebak: nilai ini langsung menentukan pita
 * kewajaran, dan pita yang salah menghukum Tenant yang tidak bersalah.
 */
model CommoditySeasonBaseline {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commodityId       String  @map("commodity_id") @db.Uuid
  season            Season
  ndviPeakReference Decimal @map("ndvi_peak_reference") @db.Decimal(6, 4)
  /// Pemetaan puncak NDVI → faktor vigor (§6.2 poin 6).
  vigorCurveParams  Json    @default("{}") @map("vigor_curve_params")
  typicalCycleDays  Int     @map("typical_cycle_days")
  calibrationSource String  @map("calibration_source")

  commodity Commodity @relation(fields: [commodityId], references: [id])

  @@unique([commodityId, season], map: "commodity_season_unik")
  @@map("commodity_season_baselines")
}

/**
 * Riwayat penilaian kewajaran hasil per batch (FR-4.10, FR-7.12a).
 *
 * TABEL, bukan kolom di Batch (ERD v2.3 poin 1). Tiga alasan: satu batch dapat dinilai
 * ULANG saat scene satelit baru menembus awan; halaman TN-35 menuntut riwayatnya; dan
 * `basis` merekam ATAS DASAR APA penilaian dibuat — tanpa itu `WAJAR` dari pita saja
 * tidak bisa dibedakan dari `WAJAR` dari pita + benchmark, padahal kekuatan buktinya
 * jauh berbeda.
 */
model YieldAssessment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId     String   @map("batch_id") @db.Uuid
  assessedAt  DateTime @default(now()) @map("assessed_at") @db.Timestamptz(6)
  reportedBox Int      @map("reported_box")
  /// Rentang sengaja LEBAR — menandai yang tidak masuk akal, bukan mengaudit selisih kecil.
  expectedYieldMin   Decimal? @map("expected_yield_min") @db.Decimal(12, 2)
  expectedYieldMax   Decimal? @map("expected_yield_max") @db.Decimal(12, 2)
  peakNdviUsed       Decimal? @map("peak_ndvi_used") @db.Decimal(6, 4)
  /// null bila benchmark zona belum tersedia (< 5 batch pembanding — FR-7.12e).
  zoneBenchmarkRatio Decimal? @map("zone_benchmark_ratio") @db.Decimal(6, 4)
  basis              AssessmentBasis
  verdict            YieldPlausibility
  reviewedById       String?   @map("reviewed_by") @db.Uuid
  slaDueAt           DateTime? @map("sla_due_at") @db.Timestamptz(6)
  /// Terisi setelah tinjauan Operator (OP-13); inilah yang menentukan cap 10% berlaku.
  finalVerdict       YieldPlausibility? @map("final_verdict")
  /// Penilaian MANA yang akhirnya menjadi panen — bukan sekadar yang terakhir (TN-35).
  confirmedAt        DateTime?          @map("confirmed_at") @db.Timestamptz(6)

  batch      Batch @relation(fields: [batchId], references: [id])
  reviewedBy User? @relation("PenilaiKewajaran", fields: [reviewedById], references: [id])

  @@index([batchId, assessedAt(sort: Desc)], map: "yield_assessments_batch_idx")
  // Indeks unik PARSIAL "satu penilaian dikonfirmasi per batch" hidup di migrasi
  // 20260812040000 — Prisma tidak bisa menyatakan WHERE pada @@unique, dan menuliskannya
  // sebagai @@unique biasa justru akan melarang batch punya lebih dari satu penilaian.
  @@map("yield_assessments")
}
