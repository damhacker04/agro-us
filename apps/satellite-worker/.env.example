# Sama dengan apps/api/.env — worker menulis ke basis data yang sama.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrous"

# Kredensial Copernicus Data Space (gratis, daftar di dataspace.copernicus.eu).
# Kosongkan bila memakai mode sintetis.
COPERNICUS_USER=""
COPERNICUS_PASSWORD=""

# 1 = bangkitkan citra tiruan secara lokal. HANYA untuk pengembangan.
SYNTHETIC_SCENES=0
