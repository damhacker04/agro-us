# Salin jadi `.env` (jangan commit .env).
# Worker menulis ke basis data yang sama dengan apps/api — samakan nilainya.
# Ganti <PASSWORD> sesuai POSTGRES_PASSWORD container Postgres.
DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/agrous"

# Katalog citra. Default: Earth Search (AWS Open Data) — Sentinel-2 L2A dari ESA
# dalam format COG, tanpa kredensial. Arahkan ke katalog CDSE bila ingin memakai
# jalur resmi Copernicus (lihat catatan penyimpangan di src/stac_provider.py).
# STAC_URL="https://earth-search.aws.element84.com/v1/search"
# STAC_COLLECTION="sentinel-2-l2a"

# Jumlah thread pembacaan COG. Pembacaan didominasi latensi jaringan, bukan CPU.
# STAC_WORKERS=6

# 1 = bangkitkan citra tiruan secara lokal. HANYA untuk pengembangan —
# kurvanya dibangun DARI klaim Tenant sehingga selalu cenderung "terverifikasi".
SYNTHETIC_SCENES=0
