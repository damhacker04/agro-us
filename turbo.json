{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      // `^build` = bangun paket hulu dulu. packages/shared di-import lewat
      // dist/-nya, dan dist/ tidak ikut di git — tanpa baris ini `pnpm dev` di
      // clone baru menyalakan api & web sebelum shared ada, lalu banjir
      // "Cannot find module '@agro-os/shared'".
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "test:coverage:100": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
